{# Mount point for the Mollie express component. Everything it needs comes from the page
   extension assigned by the ExpressComponentsCartSubscriber; the mounting itself happens in
   the MollieExpressComponents storefront plugin, because the offcanvas cart is loaded via
   ajax and inline scripts in injected markup are never executed.

   `applePayVisible`, `googlePayVisible` and `paypalExpressVisible` control the matching button
   inside the component: false hides it, true or not passed leaves it on automatic. #}
{% set mollieExpress = page.extensions.mollieExpressComponents|default(null) %}

{% if mollieExpress is not null and mollieExpress.clientAccessToken is not empty %}
    {% set mollieExpressOptions = {
        buttons: {
            applepay: { visibility: (applePayVisible ?? true) ? 'automatic' : 'hidden' },
            googlepay: { visibility: (googlePayVisible ?? true) ? 'automatic' : 'hidden' },
            paypal: { visibility: (paypalExpressVisible ?? true) ? 'automatic' : 'hidden' }
        }
    } %}

    {% block mollie_express_component %}
        <div class="mt-2 mollie-express-component"
             data-mollie-express-component
             data-client-access-token="{{ mollieExpress.clientAccessToken }}"
             data-locale="{{ app.request.locale }}"
             data-options="{{ mollieExpressOptions|json_encode }}"></div>
    {% endblock %}
{% endif %}
