{% sw_extends '@Storefront/storefront/page/checkout/confirm/index.html.twig' %}

{% block page_checkout_main_content %}

    {% if mollie_applepay_enabled %}
        <div id="mollie_hide_applepay" data-mollie-template-applepay-checkout
             data-mollie-apple-pay-payment-method-options="{{ {
                 shopUrl: seoUrl('frontend.home.page'),
                 applePayId: apple_pay_payment_method_id,
             }
             |json_encode }}"></div>
    {% endif %}


    {% if page.enable_credit_card_components == true %}
        <script src="https://js.mollie.com/v1/mollie.js"></script>
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block page_checkout_aside_actions %}
    {{ parent() }}

    {# deliberately extending this block and not page_checkout_confirm_form_submit: the buy button
       sits inside #confirmOrderForm, and the mount container has to end up outside of it #}
    {% block page_checkout_aside_actions_mollie_express_components %}
        {% sw_include '@MolliePayments/mollie/component/express-component.html.twig' %}
    {% endblock %}
{% endblock %}
