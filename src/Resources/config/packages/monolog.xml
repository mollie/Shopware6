<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:monolog="http://symfony.com/schema/dic/monolog"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
        https://symfony.com/schema/dic/services/services-1.0.xsd
        http://symfony.com/schema/dic/monolog
        https://symfony.com/schema/dic/monolog/monolog-1.0.xsd
">
    <monolog:config>
        <monolog:channel>mollie</monolog:channel>

        <!-- type="service" handlers configure their own level and bubble in the constructor; the level/bubble attributes are ignored here by Symfony. -->
        <!-- The channels element restricts the handler to our own channel. Without it Monolog attaches the handler to every channel, so records of other plugins would end up in our log files. -->
        <monolog:handler
                name="mollie_order_file"
                type="service"
                id="Mollie\Shopware\Component\Logger\OrderFileHandler"
        >
            <monolog:channels>
                <monolog:channel>mollie</monolog:channel>
            </monolog:channels>
        </monolog:handler>

        <monolog:handler
                name="mollie_rotation_file"
                type="service"
                id="Mollie\Shopware\Component\Logger\PluginSettingsHandler"
        >
            <monolog:channels>
                <monolog:channel>mollie</monolog:channel>
            </monolog:channels>
        </monolog:handler>
    </monolog:config>
</container>
